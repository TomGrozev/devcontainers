{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versioned GitHub release downloads in Dockerfiles",
      "managerFilePatterns": [
        "/^images\\/[^\\/]+\\/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+) extractVersion=(?<extractVersion>[^\\s]+)\\nARG (?<varName>[A-Z_]+)_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}",
      "extractVersionTemplate": "{{{extractVersion}}}"
    },
    {
      "customType": "regex",
      "description": "Update version variables in docker-bake.hcl",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "\\/\\/ renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)( extractVersion=(?<extractVersion>[^\\s]+))?\\nvariable \"(?<varName>[^\"]+)\" \\{\\n\\s+default = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}",
      "extractVersionTemplate": "{{{extractVersion}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group Elixir + OTP + Debian toolchain updates",
      "matchPackageNames": ["hexpm/elixir", "erlang/otp"],
      "groupName": "elixir-toolchain"
    },
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Automerge minor updates so the scheduled release can deploy them",
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Pin git-graph to the Debian forky pool (not in trixie)",
      "matchDatasources": ["deb"],
      "matchPackageNames": ["git-graph"],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=forky&components=main&binaryArch=amd64"
      ]
    }
  ]
}
